# --- Secrets / local config --------------------------------------------------
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / Next.js (frontend/ has its own .gitignore as well) -----------------
node_modules/
.next/

# --- Datasets: user-supplied and large, never committed (see data/README.md) ---
data/raw/
data/processed/
*.pcap
*.pcapng
!data/samples/*.pcap
!data/samples/*.pcapng

# --- Model artefacts: versioned bundles live under models/<name>/<version>/ ---
models/*
!models/README.md

# --- Generated output --------------------------------------------------------
logs/
*.log

# --- Legacy prototype's runtime folders --------------------------------------
legacy/data/
legacy/models/
legacy/logs/

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
