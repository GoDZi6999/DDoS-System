# Copy to .env and adjust:  cp .env.example .env
# docker-compose.yml reads this file automatically. Every value below is a
# development default; set real secrets before exposing the stack.

# development | production (production refuses to start without JWT_SECRET)
ENVIRONMENT=development

# --- PostgreSQL --------------------------------------------------------------
# Passwords are embedded in database URLs: use URL-safe characters only
# (letters, digits, - _ . ~).
# Schema owner, used only by the one-shot migrate service.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
# Least-privilege role used by the API and alert engine. Both are applied only
# when the database volume is first created (`docker compose down -v` resets).
APP_DB_USER=sentinel_app
APP_DB_PASSWORD=sentinel_app

# --- Redis --------------------------------------------------------------------
# Embedded in Redis URLs too: URL-safe characters only.
REDIS_PASSWORD=sentinel_redis
# Capture sensors (docker-compose.sensor.yml): password of the restricted
# `sensor` account, e.g. `openssl rand -hex 24`. Empty disables the account.
SENSOR_REDIS_PASSWORD=
# Where Redis is published for sensors. 127.0.0.1 serves a sensor on this
# machine; 0.0.0.0 serves other hosts (firewall/VPN it: Redis is unencrypted).
SENSOR_BIND=127.0.0.1
SENSOR_PORT=6379

# --- Authentication ----------------------------------------------------------
# HS256 signing key, 32+ characters, e.g. `openssl rand -hex 32`. Left empty, a
# development backend uses a random key and sessions end when it restarts.
JWT_SECRET=
# First admin account, created on first start. Left empty, a password is
# generated and printed once: `docker compose logs migrate`. Minimum 12 chars.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# --- Host ports (bound to 127.0.0.1 only) -----------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Dashboard --------------------------------------------------------------
# true when the dashboard is served over HTTPS (behind a TLS reverse proxy):
# session cookies are then sent over HTTPS only.
COOKIE_SECURE=false

# --- Notifications (notifier service) ----------------------------------------
# Channels (email lists, Slack, webhooks) are managed in the dashboard. Email
# needs an SMTP relay. For local testing, run the bundled mail catcher:
#   COMPOSE_PROFILES=mail, SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURITY=none
# COMPOSE_PROFILES=mail
SMTP_HOST=
SMTP_PORT=587
# starttls | tls | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ArgusAI <sentinelai@localhost>
# Base URL used for links in notifications.
DASHBOARD_URL=http://localhost:3000
# Webhook/Slack targets must be public https addresses unless this is true
# (only for testing with a receiver on your own network).
NOTIFY_ALLOW_PRIVATE_TARGETS=false

# --- Data retention (applied by the notifier every 6 hours) ------------------
# Flows older than this are deleted unless they are evidence for an alert that
# is open or was closed within EVIDENCE_RETENTION_DAYS. The audit log is kept.
EVENT_RETENTION_DAYS=14
EVIDENCE_RETENTION_DAYS=90
DELIVERY_RETENTION_DAYS=30

# --- Optional monitoring (COMPOSE_PROFILES=monitoring) ----------------------
# Grafana on http://localhost:3001 (user admin). Prometheus on :9090.
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Set to false to turn off the API's /metrics endpoint.
METRICS_ENABLED=true

# --- Model ---------------------------------------------------------------------
# Default bundle; models/sentinel-flow/2026.10.04 is an opt-in candidate with
# 45% fewer false positives but lower botnet recall (docs/ML_METHODOLOGY.md).
MODEL_BUNDLE=models/sentinel-flow/2026.10.03

# --- Analysis API (optional: docker compose --profile api up -d analysis-api) --
# Comma-separated name:sha256 entries; create one with
#   docker compose run --rm engine python -m sentinel_engine api-key --name acme
# ARGUS_API_KEYS=
ARGUS_API_RATE_PER_MINUTE=60
ANALYSIS_API_PORT=8100
