# Copy to .env and adjust:  cp .env.example .env
# docker-compose.yml reads this file automatically. Every value below is a
# development default; set real passwords before exposing the stack.

# --- PostgreSQL --------------------------------------------------------------
# The password is embedded in the backend's DATABASE_URL: use URL-safe
# characters only (letters, digits, - _ . ~).
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# --- Host ports (bound to 127.0.0.1 only) -----------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
